{
  "name": "werkraum",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @werkraum/web dev",
    "build": "pnpm --filter @werkraum/shared build && pnpm --filter @werkraum/web build",
    "start": "pnpm --filter @werkraum/web start",
    "worker": "pnpm --filter @werkraum/web worker",
    "db:migrate": "pnpm --filter @werkraum/web db:migrate",
    "db:seed": "pnpm --filter @werkraum/web db:seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "predeploy": "pnpm db:migrate 2>&1 && pnpm db:seed 2>&1"
  }
}
