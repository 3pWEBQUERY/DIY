# ── Pflicht ─────────────────────────────────────────────
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/werkraum
# Öffentliche URL (Railway: https://${{RAILWAY_PUBLIC_DOMAIN}})
APP_URL=http://localhost:3000
# Mind. 32 Zeichen, z. B. `openssl rand -base64 48`
SESSION_SECRET=

# ── Railway Bucket (S3-kompatibel) ──────────────────────
# Railway: Variablen-Referenzen auf den Bucket-Service
# S3_ENDPOINT=${{Bucket.ENDPOINT}}
# S3_BUCKET=${{Bucket.BUCKET}}
# S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# S3_REGION=${{Bucket.REGION}}
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false

# ── Zahlungen (Stripe Connect) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── E-Mail (Resend) ─────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=WERKRAUM <hallo@werkraum.ch>

# ── Anmelden mit Apple ──────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8, Zeilenumbrüche als \n
APPLE_PRIVATE_KEY=

# ── Optional ────────────────────────────────────────────
DB_POOL_MAX=10
INLINE_MEDIA_PROCESSING=true
