# ── Pflicht ─────────────────────────────────────────────
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/werkraum
# Öffentliche URL (Railway: https://${{RAILWAY_PUBLIC_DOMAIN}})
APP_URL=http://localhost:3000
# Mind. 32 Zeichen, z. B. `openssl rand -base64 48`
SESSION_SECRET=
# Schlüssel der Audit-Kette (HMAC), mind. 32 Zeichen, z. B. `openssl rand -base64 48` – web und worker
# identisch, nie wechseln. Leer: einfache SHA-256-Kette (Warnung in Produktion)
AUDIT_HMAC_KEY=

# ── Railway Bucket (S3-kompatibel) ──────────────────────
# Railway: Variablen-Referenzen auf den Bucket-Service
# S3_ENDPOINT=${{Bucket.ENDPOINT}}
# S3_BUCKET=${{Bucket.BUCKET}}
# S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# S3_REGION=${{Bucket.REGION}}
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false

# ── Zahlungen (Stripe Connect) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── E-Mail (Resend) ─────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=WERKRAUM <hallo@werkraum.ch>

# ── Anmelden mit Apple ──────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8, Zeilenumbrüche als \n
APPLE_PRIVATE_KEY=

# ── Anmelden mit Pinterest (developers.pinterest.com → My apps) ──
# Redirect-URI in der Pinterest-App: <APP_URL>/api/auth/pinterest/callback
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ── iOS-App ─────────────────────────────────────────────
# Anmelden mit Apple in der App: Bundle-ID (Audience des identityToken)
APPLE_IOS_CLIENT_ID=ch.werkuno.app
# Push (APNs): Schlüssel aus developer.apple.com → Keys (.p8), Zeilenumbrüche als \n
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=ch.werkuno.app

# ── Optional ────────────────────────────────────────────
DB_POOL_MAX=10
INLINE_MEDIA_PROCESSING=true
