model Conversation {
  id           String   @id @default(cuid())
  kind         String   @default("DIRECT") // DIRECT | ORDER | GROUP
  /// Gruppenname (nur GROUP)
  title        String?
  createdById  String?
  orderId      String?
  productId    String?
  lastMessageAt DateTime @default(now())
  createdAt    DateTime @default(now())

  members      ConversationMember[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  /// Zuletzt auf einem Gerät angekommen (Posteingang/Zähler abgerufen) – für „zugestellt“ (✓✓ grau)
  lastDeliveredAt DateTime?
  archivedAt     DateTime?
  isRequest      Boolean      @default(false)
  /// Gruppen: ADMIN darf Mitglieder verwalten und umbenennen
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  /// TEXT | SYSTEM (Gruppenereignisse wie „X hat Y hinzugefügt“)
  kind           String       @default("TEXT")
  media          Json         @default("[]")
  flags          String[]     @default([]) // SUSPICIOUS_PAYMENT_LINK, …
  state          ContentState @default(PUBLISHED)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ───────────────────────────── Handel ─────────────────────────────

model Shop {
  id               String            @id @default(cuid())
  ownerId          String            @unique
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug             String            @unique
  name             String
  tagline          String            @default("")
  description      String            @default("")
  status           ShopStatus        @default(DRAFT)
  sellerType       SellerType        @default(PRIVATE)
  country          String            @default("CH")
  currency         String            @default("CHF")
  shippingPolicy   String            @default("")
  returnPolicy     String            @default("")
  processingDays   Int               @default(3)
  stripeAccountId  String?           @unique
  /// Modus des Stripe-Schlüssels, mit dem das Konto angelegt bzw. zuletzt erreicht wurde (live | test).
  /// Wechselt die Plattform von Test auf Live, werden Testkonten erkannt und gelöst (shops.ts).
  stripeAccountMode String?
  payoutsEnabled   Boolean           @default(false)
  /// Auszahlungsplan, den Werkuno ausführt (manual | daily | weekly | monthly). Bei Stripe steht jedes
  /// Konto auf „manuell“ – so wird nur freigegebenes Guthaben ausgezahlt (Haltefrist, src/server/commerce/escrow.ts)
  payoutInterval      String        @default("manual")
  payoutWeeklyAnchor  String?
  payoutMonthlyAnchor Int?
  /// Letzte automatische Auszahlung durch Werkuno (höchstens eine pro Tag)
  lastAutoPayoutAt    DateTime?
  /// Bisheriger Stripe-Auszahlungsplan übernommen und Stripe auf „manuell“ gestellt
  payoutScheduleMigratedAt DateTime?
  /// Von der Administration erlassene Haltefrist (vertrauenswürdige Shops): Guthaben sofort auszahlbar
  payoutHoldWaived    Boolean       @default(false)
  chargesEnabled   Boolean           @default(false)
  ratingAvg        Float             @default(0)
  ratingCount      Int               @default(0)
  salesCount       Int               @default(0)
  /// Letzter Abgleich des Connect-Kontos bzw. der Auszahlungen im Worker (Reihum-Auswahl, auch bei Fehlern gesetzt)
  connectSyncAt    DateTime?
  payoutsSyncAt    DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  verification     SellerVerification?
  products         Product[]
  orders           Order[]
  payouts          PayoutRecord[]
}

model SellerVerification {
  shopId        String            @id
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  state         VerificationState @default(NOT_STARTED)
  legalName     String?
  businessName  String?
  vatId         String?
  addressLine   String?
  postalCode    String?
  city          String?
  country       String?
  providerRef   String?
  reviewedBy    String?
  reviewedAt    DateTime?
  notes         String            @default("")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Product {
  id             String        @id @default(cuid())
  shopId         String
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slug           String
  title          String
  description    String        @default("")
  kind           ProductKind   @default(UNIQUE)
  category       String
  priceMinor     Int
  currency       String        @default("CHF")
  status         ProductStatus @default(DRAFT)
  /// Kurzfassung (kommagetrennt) – für Suche und ältere App-Versionen
  materials      String        @default("")
  /// Einzelne Materialangaben, z. B. „100 % Baumwolle“, „Buchenholz, geölt“
  materialList   String[]      @default([])
  /// Zusätzliche Masse/Angaben (z. B. Durchmesser, Gewicht)
  dimensions     String        @default("")
  /// Höhe, Breite, Tiefe in Millimetern
  heightMm       Int?
  widthMm        Int?
  depthMm        Int?
  productionDays Int           @default(3)
  shippingMinor  Int           @default(900)
  shipsFrom      String        @default("CH")
  safetyInfo     String        @default("")
  returnPolicy   String        @default("")
  coverUrl       String?
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tutorialId     String?
  tutorial       Tutorial?     @relation(fields: [tutorialId], references: [id], onDelete: SetNull)
  digitalKey     String?
  ratingAvg      Float         @default(0)
  ratingCount    Int           @default(0)
  saveCount      Int           @default(0)
  viewCount      Int           @default(0)
  isFeatured     Boolean       @default(false)
  /// Ausverkauft nicht mehr öffentlich zeigen (Marktplatz, Shop, Suche, Profile); mit neuem Bestand wieder sichtbar
  hideWhenSoldOut Boolean      @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants       ProductVariant[]
  media          ProductMedia[]
  inventory      InventoryItem[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  reviews        Review[]
  posts          Post[]
  entitlements   DigitalEntitlement[]
  appStorePurchases AppStorePurchase[]
  restockRequests RestockRequest[]

  /// Generierte Spalte (GENERATED ALWAYS AS … STORED, siehe Migration init). dbgenerated() ohne Ausdruck,
  /// damit Prisma die Spalte als „hat Standardwert“ kennt und kein DROP DEFAULT erzeugt.
  search         Unsupported("tsvector")? @default(dbgenerated())
  @@unique([shopId, slug])
  @@index([status, category, publishedAt])
  @@index([priceMinor])
  @@index([projectId])
  @@index([search], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_title_trgm_idx")
}

model ProductVariant {
