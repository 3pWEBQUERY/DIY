}

// ───────────────────────────── Identität ─────────────────────────────

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  /// Zwei-Faktor (TOTP): Geheimnis AES-256-GCM-verschlüsselt; aktiv erst mit totpEnabledAt
  totpSecret      String?
  totpEnabledAt   DateTime?
  /// Zuletzt akzeptierter 30-s-Zeitschritt (verhindert Wiederverwendung eines Codes)
  totpLastStep    Int?
  mfaRecoveryCodes MfaRecoveryCode[]
  role            PlatformRole  @default(MEMBER)
  status          AccountStatus @default(ACTIVE)
  suspendedUntil  DateTime?
  messagingRestrictedUntil DateTime?
  adultConfirmedAt DateTime?
  termsAcceptedAt DateTime?
  onboardedAt     DateTime?
  locale          String        @default("de-CH")
  /// Wie das Konto registriert wurde: EMAIL | APPLE | PINTEREST | ANDROID (Admin-Anzeige)
  signupMethod    String?
  lastSeenAt      DateTime?
  /// Online-Status: online, solange onlineUntil in der Zukunft liegt (Herzschlag aus Web/App verlängert)
  onlineUntil     DateTime?
  /// Letzter Herzschlag – „zuletzt online“
  lastOnlineAt    DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile         UserProfile?
  sessions        Session[]
  pushDevices     PushDevice[]
  authAccounts    AuthAccount[]
  preference      UserPreference?
  roleAssignments RoleAssignment[]
  tokens          VerificationToken[]

  posts           Post[]
  comments        Comment[]
  reactions       Reaction[]
  following       Follow[]      @relation("follower")
  followers       Follow[]      @relation("followee")
  bookmarks       Bookmark[]
  collections     Collection[]
  notifications   Notification[] @relation("recipient")
  actedNotifications Notification[] @relation("actor")
  blocking        UserBlock[]   @relation("blocker")
  blockedBy       UserBlock[]   @relation("blocked")
  mutes           UserMute[]    @relation("muter")
  mutedBy         UserMute[]    @relation("muted")
  reports         Report[]

  projects        Project[]
  projectUpdates  ProjectUpdate[]
  contributions   ProjectContributor[]
  tutorials       Tutorial[]
  tutorialProgress TutorialProgress[]
  articles        BlogArticle[]
  communityMemberships CommunityMember[]
  communitiesOwned Community[]
  shop            Shop?
  subscription    Subscription? @relation("subscriber")
  coauthorships   PostCoauthor[] @relation("coauthor")
  challengeEntries ChallengeEntry[] @relation("challengeEntries")
  challengeVotes  ChallengeVote[] @relation("challengeVotes")
  materialStock   MaterialStock[] @relation("materialStock")
  carts           Cart[]
  orders          Order[]       @relation("buyer")
  reviews         Review[]
  entitlements    DigitalEntitlement[]
  appStorePurchases AppStorePurchase[]
  restockRequests   RestockRequest[]
  shoppingLists   ShoppingList[]
  media           Media[]
  conversationMemberships ConversationMember[]
  messages        Message[]
  moderationAssigned ModerationCase[] @relation("assignee")
  moderationSubject ModerationCase[] @relation("subjectUser")
  moderationActions ModerationAction[] @relation("moderator")
  appeals         Appeal[]
  auditEvents     AuditEvent[]
  analyticsEvents AnalyticsEvent[]
  supportTickets  SupportTicket[]

  @@index([status])
  @@index([createdAt])
  @@index([onlineUntil])
  pollVotes       PollVote[]
  organizedEvents CommunityEvent[] @relation("eventOrganizer")
  eventAttendance EventAttendee[]
  customerDetails CustomerDetails?
}

model UserProfile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle       String   @unique
  displayName  String
  bio          String   @default("")
  avatarUrl    String?
  coverUrl     String?
  region       String?
  country      String?  @default("CH")
  website      String?
  links        Json     @default("[]")
  categories   String[] @default([])
  pronouns     String?
  isCreatorPro Boolean  @default(false)
  followerCount  Int    @default(0)
  followingCount Int    @default(0)
  postCount      Int    @default(0)
  projectCount   Int    @default(0)
  dmPolicy     String   @default("FOLLOWING") // EVERYONE | FOLLOWING | NOBODY
  /// Creator Pro: bis zu 3 hervorgehobene Projekte oben im Profil
  featuredProjectIds String[] @default([])
  /// Creator Pro: Medienkit öffentlich unter /u/{handle}/medienkit
  mediaKitPublic Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  handleHistory HandleRedirect[]

  @@index([displayName])
  @@index([handle(ops: raw("gin_trgm_ops"))], type: Gin, map: "UserProfile_handle_trgm_idx")
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "UserProfile_displayName_trgm_idx")
}

model HandleRedirect {
  oldHandle String      @id
  userId    String
  profile   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model Session {
  id          String   @id // SHA-256 des Tokens, nie der Klartext
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent   String?
  ipHash      String?
  deviceLabel String?
  expiresAt   DateTime
  lastUsedAt  DateTime @default(now())
  revokedAt   DateTime?
  /// Passwort korrekt, zweiter Faktor steht noch aus – gilt bis dahin als nicht angemeldet
  mfaPending  Boolean  @default(false)
  /// Diese Sitzung hat den zweiten Faktor bestätigt (Login-Schritt 2 oder Einrichtung). Nur dann gelten
  /// Moderations-/Adminrechte – eine ältere Sitzung wird durch das Aktivieren von 2FA nicht aufgewertet.
  mfaVerifiedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  /// Bereinigung widerrufener Sitzungen (Worker: revokedAt < …)
  @@index([revokedAt], where: raw("\"revokedAt\" IS NOT NULL"))
}

/// Einmal verwendbare Wiederherstellungscodes für die Zwei-Faktor-Anmeldung (nur als Hash gespeichert)
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  /// Apple: Refresh-Token (AES-GCM verschlüsselt wie TOTP-Geheimnisse) – für den Widerruf bei Kontolöschung
  refreshToken      String?
  /// Client-ID, für die das Refresh-Token ausgestellt wurde (Web-Services-ID bzw. Bundle-ID der App)
  tokenClientId     String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  id        String       @id // SHA-256 Hash
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  payload   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model UserPreference {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests         String[] @default([])
  materials         String[] @default([])
  notificationPrefs Json     @default("{}")
  emailDigest       String   @default("DAILY") // OFF | INSTANT | DAILY | WEEKLY
  feedDefault       String   @default("FOR_YOU")
  reduceMotion      Boolean  @default(false)
  /// Lesebestätigungen in Einzelchats senden und sehen (gegenseitig wie bei WhatsApp; Gruppen immer)
  readReceipts      Boolean  @default(true)
  /// Online-Status und „zuletzt online“ zeigen (gegenseitig wie bei WhatsApp)
  showOnline        Boolean  @default(true)
  hiddenCategories  String[] @default([])
  updatedAt         DateTime @updatedAt
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // z.B. VERIFIED_SELLER, COMMUNITY_MODERATOR
  scopeType String?
  scopeId   String?
  grantedBy String?
  createdAt DateTime @default(now())

  @@unique([userId, role, scopeType, scopeId])
}

// ───────────────────────────── Medien ─────────────────────────────

model Media {
  id         String     @id @default(cuid())
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind       MediaKind
  state      MediaState @default(PENDING)
  storageKey String     @unique
  mime       String
  bytes      Int
  width      Int?
  height     Int?
  durationMs Int?
  blurhash   String?
  dominant   String?
  variants   Json       @default("{}")
  isPrivate  Boolean    @default(false)
  /// Grund, falls die Verarbeitung scheitert (z. B. Video zu lang) – wird der Person angezeigt
  processingError String?
  alt        String     @default("")
  attachedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  postMedia     PostMedia[]
  projectMedia  ProjectMedia[]
  productMedia  ProductMedia[]
  tutorialMedia TutorialMedia[]

  @@index([ownerId, createdAt])
  @@index([state, createdAt])
}

// ───────────────────────────── Social ─────────────────────────────

model Post {
  id            String       @id @default(cuid())
  authorId      String
  author        User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind          PostKind     @default(TEXT)
  body          String       @default("")
  category      String?
  visibility    Visibility   @default(PUBLIC)
  state         ContentState @default(PUBLISHED)
  isCommercial  Boolean      @default(false)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectUpdateId String?    @unique
  projectUpdate ProjectUpdate? @relation(fields: [projectUpdateId], references: [id], onDelete: SetNull)
  tutorialId    String?
  tutorial      Tutorial?    @relation(fields: [tutorialId], references: [id], onDelete: SetNull)
  articleId     String?
  article       BlogArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  communityId   String?
  community     Community?   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  isPinned      Boolean      @default(false)
  isAnnouncement Boolean     @default(false)
  repostOfId    String?
  repostOf      Post?        @relation("reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts       Post[]       @relation("reposts")
  likeCount     Int          @default(0)
  commentCount  Int          @default(0)
  saveCount     Int          @default(0)
  repostCount   Int          @default(0)
  qualityScore  Float        @default(0.5)
  reachLimited  Boolean      @default(false)
  editedAt      DateTime?
  /// Geplante Veröffentlichung (state = DRAFT bis dahin; der Worker veröffentlicht)
  scheduledAt   DateTime?
  publishedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  media         PostMedia[]
  comments      Comment[]
  poll          Poll?
  coauthors     PostCoauthor[]

  /// Generierte Spalte (GENERATED ALWAYS AS … STORED, siehe Migration init). dbgenerated() ohne Ausdruck,
  /// damit Prisma die Spalte als „hat Standardwert“ kennt und kein DROP DEFAULT erzeugt.
  search         Unsupported("tsvector")? @default(dbgenerated())
  @@index([authorId, publishedAt])
  @@index([state, visibility, publishedAt])
  @@index([category, publishedAt])
  @@index([communityId, isPinned, publishedAt])
  @@index([projectId])
  @@index([state, scheduledAt])
  @@index([repostOfId])
  @@index([search], type: Gin)
}

model PostMedia {
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaId  String
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  position Int
  alt      String @default("")

  @@id([postId, mediaId])
  @@index([postId, position])
}

model Comment {
  id         String       @id @default(cuid())
  authorId   String
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  targetType TargetType
  targetId   String
  postId     String?
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?     @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]    @relation("replies")
  body       String
  isQuestion Boolean      @default(false)
  isAnswer   Boolean      @default(false)
  state      ContentState @default(PUBLISHED)
  likeCount  Int          @default(0)
  editedAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([targetType, targetId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Reaction {
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType TargetType
  targetId   String
  kind       ReactionKind @default(LIKE)
  createdAt  DateTime     @default(now())

  @@id([userId, targetType, targetId, kind])
  @@index([targetType, targetId])
}

model Follow {
  followerId String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
}

model ProjectFollow {
  userId    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, projectId])
  @@index([projectId])
}

model Bookmark {
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType   TargetType
  targetId     String
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@id([userId, targetType, targetId])
  @@index([collectionId])
}

model Collection {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String     @default("")
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items       Bookmark[]

  @@unique([ownerId, slug])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  type        String
  targetType  TargetType?
  targetId    String?
  groupKey    String?  // Bündelung: gleiche Ereignisse eines Ziels
  count       Int      @default(1)
  data        Json     @default("{}")
  readAt      DateTime?
  emailedAt   DateTime?
  /// iOS-Push zugestellt (null = ausstehend; bei Bündelung erneut null)
  pushedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([recipientId, readAt, updatedAt])
  @@index([recipientId, groupKey])
  @@index([pushedAt, updatedAt])
  @@index([actorId])
  @@index([recipientId, updatedAt])
  /// E-Mail-Warteschlange: Teilindex nur über offene Einträge
  @@index([createdAt, id], map: "Notification_mail_pending_idx", where: raw("\"emailedAt\" IS NULL"))
  /// Bereinigung gelesener Benachrichtigungen (Worker: readAt < …)
  @@index([readAt], where: raw("\"readAt\" IS NOT NULL"))
}

/// Gerät für iOS-Push (APNs), an die Sitzung gebunden: Abmelden/Widerruf beendet den Versand (PRD §19.2).
model PushDevice {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?
  /// iOS: APNs-Gerätetoken · Web: Endpoint-URL des Push-Dienstes
  token       String    @unique
  /// IOS | WEB
  platform    String    @default("IOS")
  /// Web Push: Schlüssel des Browsers (p256dh, auth) und Gerätebeschreibung
  p256dh      String?
  auth        String?
  userAgent   String?
  /// "sandbox" (Entwicklung) oder "production"
  environment String    @default("production")
  disabledAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@index([userId])
}

model UserBlock {
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model UserMute {
  muterId   String
  muter     User     @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId   String
  muted     User     @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([muterId, mutedId])
}

model HiddenContent {
  userId     String
  targetType TargetType
  targetId   String
  createdAt  DateTime   @default(now())

  @@id([userId, targetType, targetId])
}

model Report {
  id         String          @id @default(cuid())
  reporterId String
  reporter   User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType TargetType
  targetId   String
  reason     String
  details    String          @default("")
  caseId     String?
  case       ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
}

// ───────────────────────────── Projekte ─────────────────────────────

model Project {
  id               String        @id @default(cuid())
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  description      String        @default("")
  category         String
  subcategories    String[]      @default([])
  tags             String[]      @default([])
  coverUrl         String?
  coverMediaId     String?
  difficulty       Int           @default(2)
  estimatedMinutes Int?
  actualMinutes    Int?
  budgetMinor      Int?
  currency         String        @default("CHF")
  status           ProjectStatus @default(IN_PROGRESS)
  visibility       Visibility    @default(PUBLIC)
  state            ContentState  @default(PUBLISHED)
  remixNote        String?
  viewCount        Int           @default(0)
  likeCount        Int           @default(0)
  saveCount        Int           @default(0)
  remixCount       Int           @default(0)
  commentCount     Int           @default(0)
  qualityScore     Float         @default(0.5)
  isFeatured       Boolean       @default(false)
  publishedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  media            ProjectMedia[]
  updates          ProjectUpdate[]
  materials        ProjectMaterial[]
  tools            ProjectTool[]
  outgoing         ProjectRelation[] @relation("from")
  incoming         ProjectRelation[] @relation("to")
  contributors     ProjectContributor[]
  posts            Post[]
  tutorials        Tutorial[]
  products         Product[]
  articles         ArticleProject[]
  followers        ProjectFollow[]
  communityProjects CommunityProject[]

  /// Generierte Spalte (GENERATED ALWAYS AS … STORED, siehe Migration init). dbgenerated() ohne Ausdruck,
  /// damit Prisma die Spalte als „hat Standardwert“ kennt und kein DROP DEFAULT erzeugt.
