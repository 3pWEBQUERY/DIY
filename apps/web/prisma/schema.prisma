/// Wettbewerb einer Community: Einreichung (startsAt–endsAt), danach Abstimmung durch die
/// Mitglieder (bis votingEndsAt) oder Entscheid der Jury (Moderation); Ergebnis ab resultsAt.
model CommunityChallenge {
  id           String    @id @default(cuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title        String
  description  String    @default("")
  rules        String    @default("")
  prize        String    @default("")
  /// VOTES (Publikum stimmt ab) | JURY (Moderation entscheidet)
  judging      String    @default("VOTES")
  startsAt     DateTime
  endsAt       DateTime
  votingEndsAt DateTime?
  resultsAt    DateTime?
  entryCount   Int       @default(0)
  /// bereits versandte Phasen-Benachrichtigungen (voting, jury, results)
  notified     String[]  @default([])
  createdById  String?
  createdAt    DateTime  @default(now())
  entries      ChallengeEntry[]
}

/// Einreichung: ein eigenes Projekt pro Person und Wettbewerb.
model ChallengeEntry {
  id          String             @id @default(cuid())
  challengeId String
  challenge   CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation("challengeEntries", fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project            @relation("challengeEntries", fields: [projectId], references: [id], onDelete: Cascade)
  note        String             @default("")
  voteCount   Int                @default(0)
  /// Platzierung 1–3 nach dem Ergebnis
  place       Int?
  /// ACTIVE | REMOVED (von der Moderation entfernt)
  state       String             @default("ACTIVE")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  votes       ChallengeVote[]

  @@unique([challengeId, userId])
  @@index([challengeId, state])
  @@index([userId, state])
}

model ChallengeVote {
  entryId     String
  entry       ChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation("challengeVotes", fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  createdAt   DateTime       @default(now())

  @@id([entryId, userId])
  @@index([challengeId, userId])
}

