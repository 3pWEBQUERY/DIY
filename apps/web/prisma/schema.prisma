// WERKRAUM – Fachliches Datenmodell (PRD §26)
// Konventionen (§26.3): cuid-IDs, createdAt/updatedAt, explizite FKs, Indizes auf Filterfelder.
// Geldbeträge: Integer in Minor Units (Rappen/Cent).
// Migrationen: Alle Indizes (auch GIN/Trigramm/Teilindizes aus Roh-SQL) sind hier abgebildet; CI prüft mit
// `db:drift`, dass Schema und Migrationen übereinstimmen. Nicht abbildbar und nur per Hand-Migration zu ändern:
// Ausdrücke der generierten `search`-Spalten, Funktionen wr_unaccent/wr_join, Extensions, Trigger
// AuditEvent_immutable (siehe docs/ENGINEERING.md → Datenbank-Migrationen).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  // Teilindizes (`where: raw(...)`) im Schema abbilden, damit `migrate dev` sie nicht löscht
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum PlatformRole {
  MEMBER
  PLATFORM_MODERATOR
  ADMIN
  SUPERADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum ContentState {
  PUBLISHED
  DRAFT
  HIDDEN
  REMOVED
}

enum ProjectStatus {
  IDEA
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  FILE
}

enum MediaState {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum PostKind {
  TEXT
  MEDIA
  PROJECT_UPDATE
  PROJECT_SHOWCASE
  TUTORIAL
  ARTICLE
  PRODUCT
  REPOST
}

enum ReactionKind {
  LIKE
}

enum TargetType {
  POST
  COMMENT
  PROJECT
  TUTORIAL
  TUTORIAL_STEP
  PRODUCT
  USER
  MESSAGE
  ARTICLE
  COMMUNITY
  REVIEW
}

enum ProjectRelationKind {
  REMIX
  INSPIRED_BY
  SEQUEL
}

enum CommunityVisibility {
  PUBLIC
  REQUEST
  PRIVATE
}

enum CommunityRoleKind {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum MembershipState {
  ACTIVE
  PENDING
  INVITED
  BANNED
}

enum ShopStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  PAUSED
  SUSPENDED
}

enum SellerType {
  PRIVATE
  BUSINESS
}

enum VerificationState {
