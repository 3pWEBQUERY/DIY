  SUCCEEDED
  FAILED
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  APPEALED
  CLOSED
}

enum ModerationActionKind {
  NONE
  WARN
  LIMIT_REACH
  HIDE
