  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())

  @@unique([cartId, productId, variantId])
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique // menschenlesbar, z.B. WR-24-8F3K2
  buyerId         String
  buyer           User        @relation("buyer", fields: [buyerId], references: [id], onDelete: Restrict)
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING_PAYMENT)
  currency        String      @default("CHF")
  subtotalMinor   Int
  shippingMinor   Int
  totalMinor      Int
  platformFeeMinor Int
  feeBps          Int
  shippingAddress Json
  /// Käuferangaben zum Bestellzeitpunkt (Name, Rechnungsadresse, Telefon) – bleiben unverändert
  buyerDetails    Json?
  buyerNote       String      @default("")
  checkoutSessionId String?   @unique
  reservationExpiresAt DateTime?
  paidAt          DateTime?
  shippedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  /// Bestand dieser Bestellung zurückgebucht (Storno bzw. Vollerstattung vor Versand) – verhindert doppeltes Zurückbuchen
  restockedAt     DateTime?
  /// Letzter automatischer Erstattungsversuch des Workers (Reihum-Auswahl)
  refundRetryAt   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  appStorePurchase AppStorePurchase?
  shipments       Shipment[]
  events          OrderEvent[]
  reviews         Review[]

  @@index([buyerId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title       String
  variantName String?
  unitMinor   Int
  quantity    Int
  isDigital   Boolean         @default(false)

  review      Review?
  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId   String?
  from      OrderStatus?
  to        OrderStatus
  note      String      @default("")
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider         String        @default("stripe")
  providerRef      String?       @unique
  status           PaymentStatus @default(REQUIRES_PAYMENT)
  amountMinor      Int
  currency         String
  applicationFeeMinor Int        @default(0)
  /// Gutschrift auf dem Verkäuferkonto in dessen Währung (Stripe-Saldobuchung; bei Bankkonto in EUR
  /// umgerechnet) – für die Haltefrist. Wird bei Bedarf nachgeladen.
  sellerAmountMinor   Int?
  sellerCurrency      String?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  providerRef String?      @unique
  amountMinor Int
  reason      String       @default("")
  status      RefundStatus @default(PENDING)
  requestedBy String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([orderId])
}

model Shipment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier     String    @default("")
  trackingNo  String    @default("")
  trackingUrl String?
  shippedAt   DateTime  @default(now())
  deliveredAt DateTime?
  @@index([orderId])
}

model Review {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String       @unique // Schutz vor Doppelbewertung
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  productRating Int
  sellerRating  Int?
  body        String       @default("")
  sellerReply String?
  state       ContentState @default(PUBLISHED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([productId, createdAt])
  @@index([orderId])
}

model DigitalEntitlement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItemId   String?  @unique
  licenseText   String   @default("Persönliche, nicht übertragbare Nutzung.")
  version       Int      @default(1)
  downloadCount Int      @default(0)
  downloadLimit Int?     @default(20)
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  @@unique([userId, productId])
}

/// Kauf eines digitalen Produkts in der iOS-App über Apple (In-App-Kauf, §13.7).
/// Apple ist dort Verkäufer gegenüber der Kundschaft; der Shop erhält denselben Anteil wie bei
/// einem Web-Verkauf per Stripe-Überweisung aus dem Plattformguthaben.
/// Anfrage „Wird das nachproduziert?“ zu einem ausverkauften Produkt. Pro Person und Produkt eine offene
/// Anfrage; sobald das Produkt wieder Bestand hat, wird die Person benachrichtigt (notifiedAt).
model RestockRequest {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  note       String    @default("")
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([productId, userId])
  @@index([productId, notifiedAt])
  @@index([notifiedAt])
}

model AppStorePurchase {
  id                    String                 @id @default(cuid())
  /// appAccountToken (UUID), den die App beim Kauf an Apple mitgibt
  token                 String                 @unique
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId             String
  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  appleProductId        String
  /// Preis in der App (Preisstufe inkl. Aufschlag) und Web-Preis zum Kaufzeitpunkt
  priceMinor            Int
  webPriceMinor         Int
  /// Anteil des Shops = Web-Preis − Plattformprovision (wie beim Web-Verkauf)
  sellerNetMinor        Int
  currency              String                 @default("CHF")
  status                AppStorePurchaseStatus @default(PENDING)
  transactionId         String?                @unique
  originalTransactionId String?
  environment           String?
  applePriceMilli       Int?
  appleCurrency         String?
  storefront            String?
  orderId               String?                @unique
  order                 Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transferStatus        SellerTransferStatus   @default(NONE)
  transferId            String?
  transferAttempts      Int                    @default(0)
  transferError         String?
  expiresAt             DateTime
  completedAt           DateTime?
  revokedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([userId, createdAt])
  @@index([transferStatus, updatedAt])
}

model PayoutRecord {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  providerRef String?  @unique
  amountMinor Int
  currency    String
  status      String
  arrivalAt   DateTime?
  /// automatisch nach Auszahlungsplan (Stripe) oder über Werkuno beantragt
  automatic   Boolean  @default(true)
  failureMessage String?
  /// bereits benachrichtigte Status (gegen doppelte Benachrichtigungen bei Webhook + Abgleich)
  notified    String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  @@index([shopId, createdAt])
}

/// Eingehende Provider-Webhooks – Idempotenz über eindeutige Event-ID (§13.6).
model WebhookEvent {
  id          String    @id // Provider-Event-ID
  provider    String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  /// Bereinigung verarbeiteter Webhooks (Worker: createdAt < …)
  @@index([createdAt])
}

model IdempotencyKey {
  key        String   @id
  userId     String
  scope      String
  response   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────────── Materialien ─────────────────────────────

model MaterialCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  materials Material[]
}

model Material {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  type        String
  categoryId  String
  category    MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  properties  Json             @default("{}")
  unit        String           @default("Stk")
  brand       String?
  productRef  String?
  notes       String           @default("")
  safetyInfo  String           @default("")
  createdAt   DateTime         @default(now())

  projectMaterials ProjectMaterial[]
  listItems   ShoppingListItem[]
  stock       MaterialStock[]
  offers      MaterialOffer[]

  @@index([name])
}

/// Eigener Bestand („Habe ich schon“): Material aus der Datenbank oder frei benannt.
model MaterialStock {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("materialStock", fields: [userId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  name       String
  quantity   String    @default("")
  note       String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, materialId])
  @@index([userId])
}

/// Preisvergleich: von der Redaktion gepflegte Bezugsquellen, optional als Partnerlink (Affiliate).
model MaterialOffer {
  id          String   @id @default(cuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  retailer    String
  title       String   @default("")
  url         String
  priceMinor  Int
  currency    String   @default("CHF")
  /// Packungsgrösse als Zahl in der Einheit des Materials (z.B. 50 bei „g“) – für den Preis je Einheit
  packAmount  Float?
  packLabel   String   @default("")
  isAffiliate Boolean  @default(false)
  active      Boolean  @default(true)
  checkedAt   DateTime @default(now())
  clickCount  Int      @default(0)
  lastClickAt DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([materialId, active])
}

model Tool {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  notes     String        @default("")
  safetyInfo String       @default("")
  projectTools ProjectTool[]
}

model ShoppingList {
  id         String             @id @default(cuid())
  ownerId    String
  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String
  shareToken String?            @unique
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  items      ShoppingListItem[]
}

model ShoppingListItem {
  id           String       @id @default(cuid())
  listId       String
  list         ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  materialId   String?
  material     Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  name         String
  quantity     String       @default("")
  sourceType   String?      // PROJECT | TUTORIAL
  sourceId     String?
  sourceTitle  String?
  haveIt       Boolean      @default(false)
  purchased    Boolean      @default(false)
  position     Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([listId])
}

// ───────────────────────────── Administration ─────────────────────────────

model ModerationCase {
  id            String               @id @default(cuid())
  number        Int                  @unique @default(autoincrement())
  targetType    TargetType
  targetId      String
  subjectUserId String?
  subjectUser   User?                @relation("subjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)
  status        ModerationCaseStatus @default(OPEN)
  riskScore     Int                  @default(0)
  primaryReason String
  reportCount   Int                  @default(1)
  assigneeId    String?
  assignee      User?                @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  snapshot      Json                 @default("{}")
  resolvedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  reports       Report[]
  actions       ModerationAction[]
  appeals       Appeal[]

  @@index([targetType, targetId, status])
  @@index([status, riskScore])
}

model ModerationAction {
  id          String               @id @default(cuid())
  caseId      String
  case        ModerationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  moderatorId String
  moderator   User                 @relation("moderator", fields: [moderatorId], references: [id], onDelete: Restrict)
  action      ModerationActionKind
  reason      String
  publicNote  String               @default("")
  until       DateTime?
  createdAt   DateTime             @default(now())
}

model Appeal {
  id         String         @id @default(cuid())
  caseId     String
  case       ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement  String
  status     AppealStatus   @default(OPEN)
  decidedBy  String?
  decision   String?
  createdAt  DateTime       @default(now())
  decidedAt  DateTime?
}

/// Append-only. `hash` = SHA-256(prevHash + Inhalt) → Manipulation erkennbar (§24.3).
model AuditEvent {
  id         String   @id @default(cuid())
  seq        Int      @unique @default(autoincrement())
  actorId    String?
  /// Restrict statt SetNull: Das Protokoll ist unveränderlich (Trigger verbietet UPDATE) und actorId ist Teil
  /// der Hash-Kette – Konten mit Audit-Einträgen werden nie hart gelöscht, nur anonymisiert (status DELETED).
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  meta       Json     @default("{}")
  prevHash   String?
  hash       String
  /// Verfahren des Hashes: "sha256" (ältere Einträge, ohne Schlüssel) oder "hmac-sha256-v1" (mit AUDIT_HMAC_KEY)
  alg        String   @default("sha256")
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
}

/// Prüfpunkte der Audit-Kette ({seq, hash, at}): täglich vom Worker und nach jeder erfolgreichen Prüfung
/// geschrieben, zusätzlich als Log-Zeile `audit_checkpoint` ausserhalb der Datenbank. Unveränderlich (Trigger).
model AuditCheckpoint {
  id         String    @id @default(cuid())
  /// AuditEvent.seq des Kettenkopfs zum Zeitpunkt des Prüfpunkts
  seq        Int
  /// AuditEvent.hash dieses Eintrags
  hash       String
  /// HMAC über seq/hash/createdAt (AUDIT_HMAC_KEY) – ohne Schlüssel null
  mac        String?
  /// Gesetzt, wenn die Kette bis hier lückenlos geprüft wurde (Startpunkt der nächsten inkrementellen Prüfung)
  verifiedAt DateTime?
  /// "worker" (täglicher Prüfpunkt) oder "verify" (Prüfung in der Administration)
  source     String
  createdAt  DateTime  @default(now())

  @@index([seq])
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String   @default("")
  rollout     Int      @default(100)
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model EditorialCollection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  kicker      String   @default("")
  description String   @default("")
  items       Json     @default("[]") // [{type, id}]
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  season      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Overrides für die fest definierten DIY-Kategorien (packages/shared). Slugs bleiben fix.
model CategorySetting {
  slug        String   @id
  name        String?
  short       String?
  description String?
  isActive    Boolean  @default(true) // false = nicht mehr für neue Inhalte angeboten
  isFocus     Boolean? // Override für „Startschwerpunkt“
  sortOrder   Int?
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  subject   String
  body      String
  topic     String   @default("GENERAL")
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Outbox für Domänenereignisse (§27.3) – transaktional geschrieben, vom Worker verteilt.
model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  publishedAt DateTime?
  attempts    Int       @default(0)
  /// Nächster Versuch nach einem Fehler (exponentielles Backoff); null = sofort
  nextAttemptAt DateTime?
  /// Letzte Fehlermeldung (gekürzt) – für die Fehlerüberwachung und manuelle Klärung
  lastError   String?
  /// Von einem Worker-Prozess beansprucht (Lease): verhindert doppelte Verarbeitung, wenn beim
  /// Deploy kurz zwei Worker laufen. Ein abgelaufener Claim (Absturz) wird neu vergeben.
  claimedAt   DateTime?
  claimedBy   String?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
}

/// Aggregierte, pseudonyme Nutzungsereignisse (§30). Keine Klartext-PII.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  targetType String?
  targetId   String?
  ownerId    String?
  meaningful Boolean  @default(false)
  props      Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([ownerId, name, createdAt])
  @@index([userId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  @@index([resetAt])
}

/// Fehlerüberwachung: gleichartige Fehler werden über einen Fingerabdruck gruppiert.
model ErrorGroup {
  id          String            @id @default(cuid())
  fingerprint String            @unique
  source      String            // SERVER | CLIENT | WORKER
  name        String
  message     String
  stack       String?
  lastPath    String?
  count       Int               @default(1)
  usersHit    Int               @default(0)
  firstSeenAt DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())
  /// Erledigt markiert; tritt der Fehler erneut auf, wird er wieder geöffnet (Regression)
  resolvedAt  DateTime?
  ignoredAt   DateTime?
  lastAlertAt DateTime?
  release     String?
  occurrences ErrorOccurrence[]

  @@index([resolvedAt, ignoredAt, lastSeenAt])
}

model ErrorOccurrence {
  id        String     @id @default(cuid())
  groupId   String
  group     ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  path      String?
  method    String?
  userId    String?
  userAgent String?
  release   String?
  digest    String?
  meta      Json       @default("{}")

  @@index([groupId, createdAt])
  @@index([createdAt])
}

/// Umfrage zu einem Beitrag (Frage = Beitragstext). Ergebnisse erst nach Abstimmung oder Ende sichtbar.
model Poll {
  id          String       @id @default(cuid())
  postId      String       @unique
  post        Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  endsAt      DateTime
  multiple    Boolean      @default(false)
  voterCount  Int          @default(0)
  endNotifiedAt DateTime?
  createdAt   DateTime     @default(now())
  options     PollOption[]
  votes       PollVote[]

  @@index([endsAt, endNotifiedAt])
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  position  Int
  voteCount Int        @default(0)
  votes     PollVote[]

  @@index([pollId, position])
}

model PollVote {
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([pollId, userId, optionId])
  @@index([userId])
}

/// Treffen, Workshops und Tauschbörsen innerhalb einer Community.
model CommunityEvent {
  id             String          @id @default(cuid())
  communityId    String
  community      Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  organizerId    String
  organizer      User            @relation("eventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  title          String
  description    String          @default("")
  kind           String          @default("MEETUP") // MEETUP | WORKSHOP | SWAP | OTHER
  mode           String          @default("IN_PERSON") // IN_PERSON | ONLINE
  startsAt       DateTime
  endsAt         DateTime
  locationName   String          @default("")
  address        String          @default("")
  onlineUrl      String          @default("")
  capacity       Int?
  costNote       String          @default("")
  state          String          @default("SCHEDULED") // SCHEDULED | CANCELLED
  cancelReason   String          @default("")
  goingCount     Int             @default(0)
  interestedCount Int            @default(0)
  reminderSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendees      EventAttendee[]

  @@index([communityId, startsAt])
  @@index([state, startsAt])
}

model EventAttendee {
  eventId   String
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String         // GOING | INTERESTED
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@id([eventId, userId])
  @@index([userId, status])
}

/// Persönliche Angaben für Bestellungen – einmal erfasst, bei jeder Bestellung verwendet.
model CustomerDetails {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  line1      String
  line2      String   @default("")
  postalCode String
  city       String
  country    String
  phone      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Creator Pro (PRD §22.3): Abo über Stripe Billing oder von der Administration geschenkt.
model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation("subscriber", fields: [userId], references: [id], onDelete: Cascade)
  plan              String    @default("PRO")
  /// month | year | comp (geschenkt)
  interval          String
  /// active | trialing | past_due | canceled | incomplete | incomplete_expired | unpaid
  status            String
  /// stripe | simulated | comp
  provider          String
  customerId        String?
  subscriptionId    String?   @unique
  /// Stripe-Modus, in dem das Abo zuletzt erreichbar war (live | test) – nach Wechsel Test → Live geprüft
  stripeMode        String?
  priceMinor        Int?
  currency          String    @default("CHF")
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  grantedById       String?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
}

/// Koautorenschaft (PRD §9.3): Eingeladene Personen bestätigen, erst dann erscheinen sie am Beitrag.
model PostCoauthor {
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("coauthor", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  /// PENDING | ACCEPTED (Ablehnen löscht die Einladung)
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@id([postId, userId])
  @@index([userId, status])
}
