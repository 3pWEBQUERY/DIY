{
  "name": "@werkraum/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@werkraum/shared": "workspace:*",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "prisma": "^7.10.1",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
